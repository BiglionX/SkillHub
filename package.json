{
  "name": "skillhub",
  "version": "1.0.0",
  "private": true,
  "description": "Skill Hub - ProClaw AI 技能市场平台 (pnpm + turbo monorepo)",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "pnpm --filter @skillhub/web start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @skillhub/web run test:e2e",
    "test:cypress": "pnpm --filter @skillhub/web run test:cypress",
    "db:generate": "pnpm --filter @skillhub/web run db:generate",
    "db:push": "pnpm --filter @skillhub/web run db:push",
    "db:migrate": "pnpm --filter @skillhub/web run db:migrate",
    "ci:version": "changeset version",
    "ci:publish": "changeset publish",
    "ci": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.11",
    "@eslint/js": "^9.18.0",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  }
}
