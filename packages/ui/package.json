{
  "name": "@skillhub/ui",
  "version": "0.1.0",
  "private": true,
  "description": "SkillHub 共享 UI tokens + glass class 常量（v2.0.7+：apps/helper 与 apps/web 单一来源）",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tokens": {
      "types": "./src/tokens/index.ts",
      "default": "./src/tokens/index.ts"
    },
    "./glass-classes": {
      "types": "./src/tokens/glass-classes.ts",
      "default": "./src/tokens/glass-classes.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "echo 'no lint config in @skillhub/ui (tokens only)'",
    "test": "echo 'no tests in @skillhub/ui'"
  },
  "peerDependencies": {
    "react": "^18 || ^19"
  }
}