{
  "name": "@skillhub/cli",
  "version": "1.0.0",
  "private": true,
  "description": "Skill Hub CLI - 技能发布/安装/搜索命令行工具 (兼容 ClawHub/Agent Skills 协议)",
  "bin": {
    "skillhub": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "tsc -p tsconfig.json && node scripts/add-shebang.js",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "chalk": "^4.1.2",
    "commander": "^11.0.0",
    "fs-extra": "^11.1.1",
    "inquirer": "^8.2.5",
    "ora": "^5.4.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.1",
    "@types/inquirer": "^8.2.5",
    "@types/jest": "^29.5.5",
    "@types/node": "^20.0.0",
    "@types/ora": "^3.2.0",
    "jest": "^29.7.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
