generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String              @id @default(uuid())
  email              String              @unique
  name               String?
  image              String?
  bio                String?
  emailVerified      DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  isDisabled         Boolean             @default(false)
  password           String?
  resetToken         String?
  resetTokenExpiry   DateTime?
  role               UserRole            @default(USER)
  accounts           Account[]
  apiKeys            ApiKey[]
  auditLogs          AuditLog[]
  bountyApplications BountyApplication[]
  bountySubmissions  BountySubmission[]
  namespaces         NamespaceMember[]
  ownedNamespaces    Namespace[]         @relation("NamespaceOwner")
  notifications      Notification[]
  reviews            Review[]
  sessions           Session[]
  assignedBounties   SkillBounty[]       @relation("BountyAssignee")
  createdBounties    SkillBounty[]       @relation("BountyCreator")
  collections        SkillCollection[]
  comments           SkillComment[]
  feedbacks          SkillFeedback[]
  /// M4：游客会话（匿名 UUID v4 + 机器指纹），bind-guest 后关联到用户
  guestSessions      GuestSession[]
  /// M4：用量记录（每次 LLM 调用，bind 前存 guestSessionId，bind 后存 userId）
  usageRecords       UsageRecord[]
  skills             Skill[]
  following          UserFollow[]        @relation("Followers")
  followers          UserFollow[]        @relation("Following")

  @@map("users")
}

model Skill {
  id               String          @id @default(uuid())
  name             String
  description      String
  version          String
  category         String
  tags             String[]
  screenshots      String[]
  status           SkillStatus     @default(DRAFT)
  authorId         String
  createdAt        DateTime        @default(now())
  currency         String          @default("CNY")
  downloadCount    Int             @default(0)
  iconUrl          String?
  isPublic         Boolean         @default(false)
  namespaceId      String?
  packageUrl       String?
  price            Decimal         @default(0) @db.Decimal(10, 2)
  rating           Float           @default(0)
  readme           String?
  reviewCount      Int             @default(0)
  slug             String          @unique
  updatedAt        DateTime        @updatedAt
  authorName       String?
  authorUrl        String?
  compatibility    Json?
  confidence       Float           @default(70)
  dependencies     Json?
  documentationUrl String?
  languages        String[]
  lastSyncedAt     DateTime?
  permissions      Json?
  qualityScore     Float           @default(0)
  repositoryUrl    String?
  source           String?
  type             SkillType       @default(PROMPT)
  sourceId         String?
  sourceUrl        String?
  starCount        Int             @default(0)
  subcategory      String?
  syncStatus       String?
  embedding        Json?
  embeddingVector  Float[]
  industryTags     String[]
  pluginCompatible Boolean         @default(false)
  pluginIds        String[]
  inputSchema      Json?
  outputSchema     Json?
  categoryPath     String?
  locale           String          @default("zh-CN")
  executionConfig  Json? // Flowise 集成配置：存储 API 端点、Docker 镜像或执行参数

  // === v3 M1 新增：交付物类型（决定详情页用哪种 Deliverable 渲染）===
  deliveryCategory  SkillDeliveryCategory? // A / B / C，不填则视为 A（兼容老数据）
  // C 类 Skill 的 LLM 配置（M2 后用 JSON Schema 校验）
  llmConfig         Json?                  // { model, system_prompt, input_schema, output_schema, ... }

  // === v3.0 新增：Agent Skills 开放标准兼容（https://agentskills.io）===
  // 注意：以下字段通过 @map 映射到 20260624_add_agent_skills_standard_support 迁移
  // 创建的下划线命名列（skill_md_content 等），与迁移 SQL 保持一致。
  skillMdContent       String?   @db.Text @map("skill_md_content") // SKILL.md 完整内容
  skillMdFrontmatter   Json?     @map("skill_md_frontmatter") // 解析后的 YAML frontmatter
  standardName         String?   @map("standard_name") // 标准 name（与 frontmatter 一致）
  standardDescription  String?   @db.Text @map("standard_description") // 标准 description
  discoveryKeywords    String[]  @default([]) @map("discovery_keywords") // 用于 Agent 渐进式披露的关键词
  agentSkillsVersion   String?   @map("agent_skills_version") // 兼容的 Agent Skills 协议版本（如 "1.0"）
  lastAnalyzedAt       DateTime? @map("last_analyzed_at") // 最近一次 SKILL.md 分析时间

  reviews          Review[]
  bounties         SkillBounty[]
  comments         SkillComment[]
  feedbacks        SkillFeedback[]
  versions         SkillVersion[]
  knowledgeFragment KnowledgeFragment?
  childItems       SkillPackItem[] @relation("SkillPackParent")
  parentPacks      SkillPackItem[] @relation("SkillPackChild")
  resources        SkillResource[] // 关联的 scripts/references/assets 资源
  translations     SkillTranslation[] // 多语言翻译
  intentTags       SkillIntentTag[]
  softwareTags     SkillSoftwareTag[]
  author           User            @relation(fields: [authorId], references: [id])
  namespace        Namespace?      @relation(fields: [namespaceId], references: [id])

  @@index([slug])
  @@index([category])
  @@index([deliveryCategory])
  @@index([status])
  @@index([source])
  @@index([sourceId])
  @@index([qualityScore(sort: Desc)])
  @@index([updatedAt(sort: Desc)])
  @@index([authorId, createdAt])
  @@index([authorId, status])
  @@index([authorId, downloadCount])
  @@index([standardName])
  @@index([agentSkillsVersion])
  @@map("skills")
}

/// Agent Skills 标准的 scripts/references/assets 资源
model SkillResource {
  id          String   @id @default(cuid())
  skillId     String
  skill       Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  type        String   // "script" | "reference" | "asset" | "other"
  path        String   // 相对路径，如 "scripts/check.sh"
  storageKey  String   // 对象存储 key
  sizeBytes   Int
  mimeType    String?
  checksum    String?  // SHA-256 校验和

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([skillId, path])
  @@index([skillId, type])
  @@map("skill_resources")
}

model SkillVersion {
  id         String   @id @default(uuid())
  version    String
  changelog  String?
  createdAt  DateTime @default(now())
  manifest   Json
  packageUrl String
  skillId    String
  skill      Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([skillId])
  @@map("skill_versions")
}

model Namespace {
  id                 String            @id @default(uuid())
  name               String
  slug               String            @unique
  description        String?
  visibility         String            @default("public")
  allowPublicPublish Boolean           @default(false)
  avatarUrl          String?
  createdAt          DateTime          @default(now())
  downloadCount      Int               @default(0)
  memberCount        Int               @default(1)
  ownerId            String
  skillCount         Int               @default(0)
  updatedAt          DateTime          @updatedAt
  type               NamespaceType
  members            NamespaceMember[]
  policy             NamespacePolicy?
  owner              User              @relation("NamespaceOwner", fields: [ownerId], references: [id])
  skills             Skill[]

  @@index([slug])
  @@map("namespaces")
}

model NamespaceMember {
  invitedBy   String?
  joinedAt    DateTime      @default(now())
  namespaceId String
  userId      String
  role        NamespaceRole
  namespace   Namespace     @relation(fields: [namespaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([namespaceId, userId])
  @@map("namespace_members")
}

model NamespacePolicy {
  allowedVersions    String[]  @default(["*"])
  autoApproveMembers Boolean   @default(false)
  maxPackageSizeMb   Int       @default(50)
  namespaceId        String    @id
  requireReview      Boolean   @default(true)
  updatedAt          DateTime  @updatedAt
  namespace          Namespace @relation(fields: [namespaceId], references: [id], onDelete: Cascade)

  @@map("namespace_policies")
}

model Review {
  id              String        @id @default(uuid())
  skillId         String
  version         String
  status          ReviewStatus  @default(PENDING_REVIEW)
  previousStatus  ReviewStatus?
  reviewerId      String?
  reviewNotes     String?
  rejectionReason String?
  automatedChecks Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  completedAt     DateTime?
  reviewer        User?         @relation(fields: [reviewerId], references: [id])
  skill           Skill         @relation(fields: [skillId], references: [id])

  @@index([skillId])
  @@index([status])
  @@map("reviews")
}

model AuditLog {
  id           String   @id @default(uuid())
  action       String
  metadata     Json?
  changes      Json?
  status       String   @default("success")
  actorId      String?
  actorIp      String?
  createdAt    DateTime @default(now())
  errorMessage String?
  resourceId   String
  resourceType String
  userAgent    String?
  actor        User?    @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([resourceType, resourceId])
  @@index([action])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

model Account {
  id                String  @id @default(uuid())
  type              String
  provider          String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  providerAccountId String
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  expires      DateTime
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model ApiKey {
  id          String    @id @default(uuid())
  userId      String
  name        String
  keyHash     String
  prefix      String
  permissions String[]  @default(["read"])
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([prefix])
  @@map("api_keys")
}

model SyncLog {
  id           String    @id @default(uuid())
  source       String
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  totalCount   Int       @default(0)
  successCount Int       @default(0)
  failedCount  Int       @default(0)
  status       String    @default("running")
  errorMessage String?
  metadata     Json?

  @@index([source])
  @@index([startedAt(sort: Desc)])
  @@map("sync_logs")
}

model CrawlerTask {
  id           String    @id @default(uuid())
  taskType     String
  target       String
  status       String    @default("pending")
  priority     Int       @default(1)
  retryCount   Int       @default(0)
  maxRetries   Int       @default(3)
  scheduledAt  DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  errorMessage String?
  result       Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@index([scheduledAt])
  @@index([createdAt(sort: Desc)])
  @@map("crawler_tasks")
}

model SkillFeedback {
  id                   String   @id @default(uuid())
  skillId              String
  userId               String?
  feedbackType         String
  currentCategory      String?
  suggestedCategory    String?
  currentSubcategory   String?
  suggestedSubcategory String?
  reason               String
  status               String   @default("pending")
  adminNotes           String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  skill                Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  user                 User?    @relation(fields: [userId], references: [id])

  @@index([skillId])
  @@index([userId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("skill_feedbacks")
}

model SkillComment {
  id        String         @id @default(uuid())
  skillId   String
  userId    String
  parentId  String?
  content   String
  rating    Int?
  upvotes   Int            @default(0)
  isEdited  Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  parent    SkillComment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies   SkillComment[] @relation("CommentReplies")
  skill     Skill          @relation(fields: [skillId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([skillId])
  @@index([userId])
  @@index([parentId])
  @@index([createdAt(sort: Desc)])
  @@map("skill_comments")
}

model UserFollow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("Followers", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("user_follows")
}

model SkillCollection {
  id          String   @id @default(uuid())
  name        String
  description String?
  userId      String
  isPublic    Boolean  @default(true)
  skills      Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isPublic])
  @@map("skill_collections")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())
  type      NotificationType
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt(sort: Desc)])
  @@map("notifications")
}

model CrawlerConfig {
  id          String   @id @default(uuid())
  configKey   String   @unique
  configValue Json
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([configKey])
  @@map("crawler_configs")
}

model SkillBounty {
  id           String              @id @default(uuid())
  title        String
  description  String
  requirements String
  reward       Decimal             @db.Decimal(10, 2)
  currency     String              @default("CNY")
  status       BountyStatus        @default(OPEN)
  creatorId    String
  assigneeId   String?
  skillId      String?
  deadline     DateTime?
  completedAt  DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  applications BountyApplication[]
  submissions  BountySubmission[]
  assignee     User?               @relation("BountyAssignee", fields: [assigneeId], references: [id])
  creator      User                @relation("BountyCreator", fields: [creatorId], references: [id])
  skill        Skill?              @relation(fields: [skillId], references: [id])

  @@index([creatorId])
  @@index([assigneeId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("skill_bounties")
}

model BountyApplication {
  id            String            @id @default(uuid())
  bountyId      String
  userId        String
  proposal      String
  estimatedTime String?
  portfolio     String?
  status        ApplicationStatus @default(PENDING)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  reviewedAt    DateTime?
  reviewNote    String?
  bounty        SkillBounty       @relation(fields: [bountyId], references: [id], onDelete: Cascade)
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([bountyId, userId])
  @@index([bountyId])
  @@index([userId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("bounty_applications")
}

model BountySubmission {
  id          String           @id @default(uuid())
  bountyId    String
  userId      String
  content     String
  description String
  attachments Json?
  status      SubmissionStatus @default(SUBMITTED)
  feedback    String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  reviewedAt  DateTime?
  bounty      SkillBounty      @relation(fields: [bountyId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([bountyId])
  @@index([userId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("bounty_submissions")
}

model playing_with_neon {
  id    Int    @id @default(autoincrement())
  name  String
  value Float? @db.Real
}

/// v3 M1 新增：技能交付物类型（决定 Skill 详情页用哪种 Deliverable 渲染）
enum SkillDeliveryCategory {
  ENVIRONMENT_DEPENDENT  // A 类：环境依赖型（PS/VSCode 插件）
  OAUTH_AUTHORIZED        // B 类：数据授权型（飞书/Notion 同步）
  CONTENT_GENERATION      // C 类：内容生成型（写文案/做 PPT/纪要）
}

/// v3 M1 新增：意图标签（LLM 解析出的功能意图）
model IntentTag {
  id        String   @id @default(cuid())
  name      String   @unique          // "image-retouch" | "content-write" | ...
  labelZh   String                    // "图片精修" | "内容写作"
  category  SkillDeliveryCategory?    // 推荐类别
  skills    SkillIntentTag[]
  createdAt DateTime @default(now())

  @@index([category])
  @@map("intent_tags")
}

/// v3 M1 新增：软件标签（PS / VSCode / Blender / Excel / Feishu / Notion / ...）
model SoftwareTag {
  id        String   @id @default(cuid())
  name      String   @unique          // "photoshop" | "vscode" | ...
  labelZh   String                    // "Photoshop" | "VS Code"
  icon      String?                   // emoji 或 URL
  skills    SkillSoftwareTag[]
  createdAt DateTime @default(now())

  @@map("software_tags")
}

/// Skill ↔ IntentTag 多对多
model SkillIntentTag {
  skillId     String
  intentTagId  String
  skill        Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)
  intentTag    IntentTag @relation(fields: [intentTagId], references: [id], onDelete: Cascade)
  weight       Int       @default(1)  // 该标签在匹配时的权重

  @@id([skillId, intentTagId])
  @@index([intentTagId])
  @@map("skill_intent_tags")
}

/// Skill ↔ SoftwareTag 多对多
model SkillSoftwareTag {
  skillId       String
  softwareTagId String
  skill         Skill       @relation(fields: [skillId], references: [id], onDelete: Cascade)
  softwareTag   SoftwareTag @relation(fields: [softwareTagId], references: [id], onDelete: Cascade)

  @@id([skillId, softwareTagId])
  @@index([softwareTagId])
  @@map("skill_software_tags")
}

/// v3 M1 新增：用户已装软件清单（Web 端多选框 / 助手自动扫描通用）
model UserInstalledSoftware {
  id          String   @id @default(cuid())
  userId      String
  softwareTagId String
  source      String                  // "WEB_CHECKBOX" | "HELPER_SCAN"
  version     String?
  helperPort  Int?                    // 助手本机 HTTP 端口（用于 LLM 转发发现）
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  @@unique([userId, softwareTagId])
  @@index([userId])
  @@map("user_installed_software")
}

enum SkillStatus {
  DRAFT
  PENDING_REVIEW
  UNDER_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
}

/// v3 M2：安装任务状态
enum InstallStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

/// v3 M2：剧本来源
enum PlaybookSource {
  BUILTIN
  PUBLISHER
}

/// v3 M2：安装任务
model InstallJob {
  id              String         @id @default(cuid())
  userId          String?
  slug            String
  version         String
  playbookId      String
  playbookSource  PlaybookSource
  status          InstallStatus  @default(PENDING)
  startedAt       DateTime?
  finishedAt      DateTime?
  totalDurationMs Int?
  errorCode       String?
  errorMessage    String?
  createdAt       DateTime       @default(now())
  events          InstallEvent[]

  @@index([userId, slug])
  @@index([status, createdAt])
  @@index([slug])
  @@map("install_jobs")
}

/// v3 M2：安装任务事件
model InstallEvent {
  id         String     @id @default(cuid())
  jobId      String
  job        InstallJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  stepId     String?
  stepType   String?
  eventType  String
  payload    Json?
  occurredAt DateTime   @default(now())

  @@index([jobId, occurredAt])
  @@index([eventType])
  @@map("install_events")
}

/// v3 M2：剧本定义（内置白名单 + 发布者声明）
model PlaybookDefinition {
  id        String         @id
  software  String
  version   String
  source    PlaybookSource
  skillSlug String?
  yaml      String         @db.Text
  schemaHash String
  status    String         @default("ACTIVE")
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([software, version])
  @@index([skillSlug])
  @@map("playbook_definitions")
}

/// v3 M2：用户软件路径库（手动补位 + 助手扫描共用）
model UserSoftwarePath {
  id          String   @id @default(cuid())
  userId      String
  software    String
  pathHash    String
  pathCipher  String   @db.Text
  version     String?
  isManual    Boolean  @default(false)
  lastUsedAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  @@unique([userId, software])
  @@map("user_software_paths")
}

enum NamespaceType {
  PERSONAL
  TEAM
  GLOBAL
}

enum NamespaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum ReviewStatus {
  DRAFT
  PENDING_REVIEW
  UNDER_REVIEW
  AUTO_APPROVED
  APPROVED
  REJECTED
  REQUIRES_CHANGES
  ARCHIVED
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum NotificationType {
  COMMENT_REPLY
  SKILL_RATED
  FOLLOW
  SKILL_UPDATED
  MENTION
  SYSTEM
}

enum BountyStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  COMPLETED
  CANCELLED
  EXPIRED
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum SubmissionStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  NEEDS_REVISION
}

enum SkillType {
  PROMPT
  KNOWLEDGE
  RULE
  SKILL_PACK
}

model KnowledgeFragment {
  id           String   @id @default(uuid())
  skillId      String   @unique
  skill        Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  version      Int      @default(1)
  contentType  String   @default("json")
  content      Json?
  rawContent   String?
  vectorized   Boolean  @default(false)
  chunkCount   Int      @default(0)
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([skillId])
  @@map("knowledge_fragments")
}

model KnowledgeVersion {
  id              String   @id @default(uuid())
  skillId         String
  knowledgeId     String
  version         Int
  contentSnapshot Json
  changelog       String?
  createdBy       String?
  createdAt       DateTime @default(now())

  @@index([skillId, knowledgeId, version])
  @@map("knowledge_versions")
}

model KnowledgeEmbedding {
  id          String   @id @default(uuid())
  skillId     String
  knowledgeId String
  chunkIndex  Int
  chunkText   String
  embedding   Float[]
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([skillId])
  @@map("knowledge_embeddings")
}

model SkillPackItem {
  packId       String
  childSkillId String
  sortOrder    Int      @default(0)
  pack         Skill    @relation("SkillPackParent", fields: [packId], references: [id], onDelete: Cascade)
  childSkill   Skill    @relation("SkillPackChild", fields: [childSkillId], references: [id], onDelete: Cascade)

  @@id([packId, childSkillId])
  @@map("skill_pack_items")
}

/// v3 M4：Provider 单价（云端权威，桌面端 1 小时缓存）
/// 一行代表一次"生效"，保留历史快照便于审计 / 回溯单价变更
model ProviderPricing {
  id           String   @id @default(cuid())
  /// Provider 标识（与 desktop helper 端 Provider 枚举一致）
  /// 取值："deepseek" | "openai" | "zhipu" | "anthropic" | "moonshot" | ...
  provider     String
  /// 模型 ID，如 "deepseek-chat"、"gpt-4o-mini"、"glm-4-flash"
  model        String
  /// 每 1k input tokens 单价（人民币）
  inputPer1k   Decimal  @db.Decimal(10, 6)
  /// 每 1k output tokens 单价（人民币）
  outputPer1k  Decimal  @db.Decimal(10, 6)
  /// 货币（默认 CNY）
  currency     String   @default("CNY")
  /// 生效时间（同一 (provider, model) 可有多条历史快照）
  effectiveAt  DateTime @default(now())
  createdAt    DateTime @default(now())

  @@unique([provider, model, effectiveAt])
  @@index([provider, model, effectiveAt(sort: Desc)])
  @@map("provider_pricing")
}

/// v3 M4：游客会话（桌面助手 / 浏览器匿名使用）
/// - 未登录用户也可享受 NLU 搜索 + Skill 安装（v2.0.2 D6 决策）
/// - bind-guest 接口将匿名会话合并到登录账号
model GuestSession {
  id                 String   @id @default(cuid())
  /// 桌面助手生成的 UUID v4 匿名 ID（桌面端 `ensure_guest_session` invoke 返回）
  anonymousId        String   @unique
  /// 机器指纹（hash(hwid + osVersion + appVersion)，辅助去重 + 反作弊）
  machineFingerprint String?
  /// 绑定到的登录用户（bind-guest 后回填；bind 前为 null）
  userId             String?
  user               User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// 助手版本（"0.3.05" 等）
  helperVersion      String?
  /// OS 版本（"Windows 11 23H2" / "macOS 14.5" / "Ubuntu 22.04"）
  osVersion          String?
  /// 首次出现时间
  firstSeenAt        DateTime @default(now())
  /// 最近一次心跳 / 用量上报时间
  lastSeenAt         DateTime @default(now())
  /// bind-guest 时间
  bindAt             DateTime?
  /// 该会话产生的用量记录（bind 前写入，bind 后保留供审计）
  usageRecords       UsageRecord[]

  @@index([userId])
  @@index([lastSeenAt(sort: Desc)])
  @@index([machineFingerprint])
  @@map("guest_sessions")
}

/// v3 M4：用量记录（每次 LLM 调用的成本 + 元数据）
/// - 桌面助手 record_usage 写入（带 client_record_id 幂等去重）
/// - bind-guest 前后都写入本表；userId 和 guestSessionId 至少一个非空
/// - costCny 由云端按 ProviderPricing 表回填或估算
model UsageRecord {
  id              String   @id @default(cuid())
  /// 匿名会话来源（bind 前写入）
  guestSessionId  String?
  guestSession    GuestSession? @relation(fields: [guestSessionId], references: [id], onDelete: SetNull)
  /// 登录用户（bind 后或登录后写入）
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// 调起的 Skill slug（Home/Explore 搜索调用时为 null）
  skillSlug       String?
  /// Provider 标识（"deepseek" | "openai" | "zhipu"）
  provider        String
  /// 模型 ID
  model           String

  /// OpenAI 兼容 usage 字段
  tokensIn        Int      @default(0)
  tokensOut       Int      @default(0)
  /// 助手 → Provider 总耗时
  durationMs      Int?

  /// 估算成本（人民币，由云端根据 ProviderPricing 计算后回填）
  costCny         Decimal? @db.Decimal(10, 6)

  /// 幂等去重 key（桌面端 crypto.randomUUID）
  /// - 客户端重复发请求不会写入多行
  /// - 用于断网重传 / 离线排队后批量上报
  clientRecordId  String?  @unique

  /// 调用实际发生时间（桌面端取 Date.now()，批量上报时为最早一条）
  occurredAt      DateTime @default(now())
  /// 入库时间
  createdAt       DateTime @default(now())

  /// 路由路径（"helper" | "cache" | "cloud" | "heuristic"）
  path            String?  @default("helper")

  @@index([userId, occurredAt(sort: Desc)])
  @@index([guestSessionId, occurredAt(sort: Desc)])
  @@index([skillSlug])
  @@index([provider])
  @@index([occurredAt(sort: Desc)])
  @@map("usage_records")
}

/// Skill 多语言翻译表
/// 支持 Skill 的 name/description/skillMdContent 在不同语言下的翻译
model SkillTranslation {
  id          String   @id @default(uuid())
  skillId     String
  skill       Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  /// 目标语言代码，如 zh-CN, en-US, ja-JP, ko-KR
  locale      String

  /// 翻译后的名称（可选，null 表示使用原始名称）
  name        String?

  /// 翻译后的描述（可选，null 表示使用原始描述）
  description String? @db.Text

  /// 翻译后的 SKILL.md 内容（可选）
  skillMdContent String? @db.Text

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// 每个 skill 每个 locale 只能有一条翻译记录
  @@unique([skillId, locale])
  @@index([skillId])
  @@index([locale])
  @@map("skill_translations")
}
