{
  "name": "@skillhub/web",
  "version": "1.0.0",
  "private": true,
  "description": "Skill Hub Web - ProClaw AI 技能市场平台前端 (Next.js App Router)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:check": "node scripts/check-playwright-config.mjs",
    "test:e2e:warmup": "node scripts/warmup-dev-server.mjs",
    "test:cypress": "cypress run",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "seed:v3": "ts-node --transpile-only prisma/seed-v3-delivery.ts",
    "seed:m2": "ts-node --transpile-only prisma/seed-m2-playbooks.ts",
    "seed:all": "pnpm seed:v3 && pnpm seed:m2",
    "check": "node check-status.js",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.9.0",
    "@prisma/client": "^5.22.0",
    "@skillhub/search-sdk": "workspace:*",
    "@skillhub/widget": "workspace:*",
    "@tanstack/react-query": "^5.66.0",
    "@upstash/redis": "^1.34.3",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "gray-matter": "^4.0.3",
    "jose": "^5.9.6",
    "lucide-react": "^0.469.0",
    "next": "^15.1.6",
    "node-cache": "^5.1.2",
    "node-cron": "^3.0.3",
    "openai": "^4.77.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "react-markdown": "^9.0.1",
    "react-syntax-highlighter": "^15.6.1",
    "recharts": "^2.15.0",
    "redis": "^4.7.0",
    "remark-gfm": "^4.0.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.0",
    "@types/node-cron": "^3.0.11",
    "@types/node-fetch": "^2.6.12",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "autoprefixer": "^10.4.20",
    "cypress": "^13.17.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "node-fetch": "^2.7.0",
    "@playwright/test": "^1.50.1",
    "postcss": "^8.5.1",
    "prisma": "^5.22.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
