{
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm --filter @skillhub/web run build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "regions": ["sin1"],
  "env": {
    "NODE_ENV": "production"
  },
  "build": {
    "env": {
      "CYPRESS_INSTALL_BINARY": "0"
    }
  },
  "crons": [
    {
      "path": "/api/cron/crawler",
      "schedule": "0 19 * * *"
    }
  ]
}
