# ============================================
# SkillHub 生产环境配置
# ============================================
# ⚠️ 重要安全提示:
# 1. 不要将此文件提交到版本控制系统
# 2. 使用强密码和密钥
# 3. 定期轮换敏感凭证
# 4. 限制环境变量访问权限
# ============================================

# 复制此文件为 .env.production 并填入实际值
# cp .env.production.example .env.production

# ============================================
# 数据库配置
# ============================================
# ⚠️ 必须修改默认密码！
# 生成强密码: openssl rand -base64 32
DATABASE_URL="postgresql://skillhub:<STRONG_PASSWORD>@db:5432/skillhub?schema=public"

# ============================================
# NextAuth 认证配置
# ============================================
# ⚠️ 必须生成新的密钥！
# 生成密钥: openssl rand -base64 32
NEXTAUTH_SECRET="<GENERATE_NEW_SECRET_KEY>"

# 生产环境的完整 URL（必须使用 HTTPS）
NEXTAUTH_URL="https://skillhub.proclaw.cc"

# ============================================
# GitHub OAuth 配置
# ============================================
# 在 https://github.com/settings/developers 创建生产环境 OAuth App
# Authorization callback URL: https://skillhub.proclaw.cc/api/auth/callback/github
GITHUB_CLIENT_ID="<YOUR_PRODUCTION_GITHUB_CLIENT_ID>"
GITHUB_CLIENT_SECRET="<YOUR_PRODUCTION_GITHUB_CLIENT_SECRET>"

# ============================================
# Redis 缓存（可选，用于速率限制和缓存）
# ============================================
REDIS_URL="redis://redis:6379"

# ============================================
# AI Embeddings 配置（语义搜索功能）
# ============================================
# 支持多个提供商：OpenAI、智谱AI、DeepSeek
# 
# 选项 1: 智谱AI (推荐，性价比高)
# 获取 API Key: https://open.bigmodel.cn/usercenter/apikeys
OPENAI_API_KEY="your-zhipu-api-key"
OPENAI_BASE_URL="https://open.bigmodel.cn/api/paas/v4"
#
# 选项 2: DeepSeek
# OPENAI_API_KEY="your-deepseek-api-key"
# OPENAI_BASE_URL="https://api.deepseek.com"
#
# 选项 3: OpenAI
# OPENAI_API_KEY="your-openai-api-key"
# OPENAI_BASE_URL="https://api.openai.com/v1" (默认，可不设置)

# ============================================
# 应用配置
# ============================================
NODE_ENV="production"
PORT=3000

# ============================================
# 文件上传配置
# ============================================
MAX_FILE_SIZE=10485760  # 10MB
UPLOAD_DIR="/app/public/uploads"

# ============================================
# CORS 配置
# ============================================
# 仅允许信任的域名（逗号分隔）
ALLOWED_ORIGINS="https://skillhub.proclaw.cc"

# ============================================
# 速率限制配置
# ============================================
# API 请求限制（每分钟）
RATE_LIMIT_MAX=100

# ============================================
# 监控和日志
# ============================================
# Sentry 错误追踪（推荐配置）
# SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"

# 日志级别: error, warn, info, debug
LOG_LEVEL="info"

# ============================================
# 备份配置（可选）
# ============================================
# BACKUP_DIR="/backups/postgres"
# BACKUP_RETENTION_DAYS=7
# AWS_S3_BUCKET="skillhub-backups"  # 用于云存储备份

# ============================================
# Neon 直连 URL（Prisma Migrate 专用）
# ============================================
DIRECT_URL="postgresql://skillhub:<STRONG_PASSWORD>@db:5432/skillhub?sslmode=require"

# ============================================
# NvwaX OIDC 认证（生产核心认证）
# ============================================
# Public client 默认无 secret；若使用 Confidential client 则必须设置
SKILLHUB_OIDC_CLIENT_ID="skillhub-web"
# SKILLHUB_OIDC_CLIENT_SECRET="<OIDC_CLIENT_SECRET>"
# 一般无需覆盖；仅测试/灰度需要
# SKILLHUB_OIDC_DISCOVERY_URL="https://account.proclaw.cc/.well-known/openid-configuration"

# ============================================
# 站点公开 URL（用于 redirect_uri 拼接与 SEO）
# ============================================
NEXT_PUBLIC_APP_URL="https://skillhub.proclaw.cc"

# ============================================
# Upstash Redis（可选；未使用自建 Redis 时）
# ============================================
# UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="xxx"

# ============================================
# SkillsMP 同步（v2 discovery / 定时同步）
# ============================================
SKILLSMP_API_KEY="<SKILLSMP_API_KEY>"

# ============================================
# 智谱 AI（部分 LLM 服务使用）
# ============================================
# ZHIPU_API_KEY="<ZHIPU_API_KEY>"

# ============================================
# Supabase Storage（技能包文件存储，可选）
# ============================================
# SUPABASE_URL="https://xxx.supabase.co"
# SUPABASE_ANON_KEY="xxx"
# SUPABASE_SERVICE_ROLE_KEY="xxx"

# ============================================
# 邮件服务（可选）
# ============================================
# RESEND_API_KEY="re_xxx"
# EMAIL_FROM="noreply@skillhub.proclaw.cc"

# ============================================
# 管理员邮箱列表（逗号分隔，权限控制）
# ============================================
ADMIN_EMAILS="admin@example.com"
